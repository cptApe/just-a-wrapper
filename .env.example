# Generated from src/features/admin/environment/lib/env-registry.ts. Run pnpm env:example to refresh.

# Required settings

# Core
# Points at the database every workspace, chat, and file record lives in
DATABASE_URL=
# Signs the session cookies that keep people signed in; changing it signs everyone out
BETTER_AUTH_SECRET=
# The public address of this deployment, used for sign-in redirects and links in email
NEXT_PUBLIC_APP_URL=

# Optional settings

# Core
# Provided by Vercel on every deploy (production, preview, development), never set by hand; tags browser events with their environment so dashboards show the environment chosen at the last sync. Elsewhere the build mode decides
# NEXT_PUBLIC_VERCEL_ENV=
# A direct, unpooled connection that pnpm db:migrate uses in preference to DATABASE_URL when running migrations
# DATABASE_URL_UNPOOLED=
# Local development only: the Neon WebSocket proxy from docker-compose.dev.yml, so the app and pnpm db:migrate use a plain local Postgres. It turns database TLS off, so production refuses it
# DATABASE_WS_PROXY=
# Identifies this app to Google so people can sign in with a Google account
# GOOGLE_CLIENT_ID=
# Proves the app is really this app when Google hands a sign-in back
# GOOGLE_CLIENT_SECRET=
# Set to true to pause new sign-ups on every path (email code and Google); people who already have an account still sign in
AUTH_SIGNUPS_CLOSED=false
# The product name people see, fixed at build time; unset shows a placeholder name, which a production build refuses
# NEXT_PUBLIC_BRAND_NAME=
# Where people write for help: the Get help link, every email footer and the legal pages; the admin console can override it; unset shows a placeholder, which a production build refuses
# SUPPORT_EMAIL=

# Anthropic
# Lets this app call Anthropic; without it seeding and the agent tester plan but never run
# ANTHROPIC_API_KEY=
# Names the seeded Fast tier agent chats run on; every deployment gets its own
# ANTHROPIC_AGENT_ID_FAST=
# Names the seeded Default tier agent chats run on; every deployment gets its own
# ANTHROPIC_AGENT_ID_DEFAULT=
# Names the seeded Pro tier agent chats run on; every deployment gets its own
# ANTHROPIC_AGENT_ID_PRO=
# Names the seeded Environment the agents run inside, which decides what they can reach
# ANTHROPIC_ENVIRONMENT_ID=
# Delivers scheduled run results right away by verifying Anthropic webhooks; unset answers 503 and results wait for the recovery sweep
# ANTHROPIC_WEBHOOK_SECRET=

# Composio
# Turns on connected apps and needs both MCP proxy keys; unset leaves connected apps visible and explains how to turn them on
# COMPOSIO_API_KEY=
# The address of this deployment’s connected-apps proxy, which the agent is allowed to reach
# MCP_PROXY_URL=
# Signs the per-person token the proxy checks; changing it revokes every issued token
# MCP_PROXY_JWT_SECRET=
# Checks that webhooks claiming to be from Composio really are; unset answers 503
# COMPOSIO_WEBHOOK_SECRET=

# Stripe
# Turns on plans, credits and billing screens; unset runs with no credit or plan limits
# STRIPE_SECRET_KEY=
# Checks Stripe’s webhook signature; unset makes the app refuse the body rather than trust it
# STRIPE_WEBHOOK_SECRET=
# How the app sells: subscriptions (monthly plans) or credits_only (one-time credits, no plans); unset means subscriptions, and the admin console can override it
# BILLING_MODE=

# Files
# Private file storage and scoped browser uploads
# BLOB_READ_WRITE_TOKEN=

# Media
# Enables image, video and voice through Vercel AI Gateway; unset leaves the controls visible and explains how to turn them on
# AI_GATEWAY_API_KEY=

# Web tools
# Selects Exa search and page reading; unset selects Anthropic web_search and web_fetch
# EXA_API_KEY=
# Selects Browserbase with its project id; omit both keys for sandbox Playwright. A partial pair prevents startup
# BROWSERBASE_API_KEY=
# The Browserbase project the agent’s browsing sessions are created in
# BROWSERBASE_PROJECT_ID=

# Email
# Sends requested and urgent emails from EMAIL_FROM; development logs emails without a key; other deployments disable email without a key
# RESEND_API_KEY=
# The From address on Resend emails; unset uses "<brand name> <hello@<brand domain>>", which needs the domain verified in Resend
# EMAIL_FROM=

# PostHog
# Sends server errors and logs to PostHog; unset falls back to the server console
# POSTHOG_PROJECT_KEY=
# Where server telemetry is sent; the EU region is the default, not the US one
POSTHOG_HOST=https://eu.i.posthog.com
# A personal PostHog key with error_tracking:write (source maps upload on Vercel builds so stack traces read) plus dashboard, insight, alert write and user read (pnpm posthog:sync); a deploy build fails without the error-tracking scope once the key is set
# POSTHOG_API_KEY=
# The numeric PostHog project those source maps are uploaded into
# POSTHOG_PROJECT_ID=
# Set to true on the deploy host to upload source maps at build time; unset, a build keeps the PostHog wrapper but uploads nothing
# POSTHOG_UPLOAD_SOURCEMAPS=
# Sends browser errors and analytics to PostHog; unset falls back to the browser console
# NEXT_PUBLIC_POSTHOG_KEY=
# Where browser telemetry is sent; the EU region is the default, not the US one
NEXT_PUBLIC_POSTHOG_HOST=https://eu.i.posthog.com
# Where PostHog links and the toolbar open, which is the EU dashboard by default
NEXT_PUBLIC_POSTHOG_UI_HOST=https://eu.posthog.com

# Cron
# Required for scheduled cleanup and recovery: authorizes the billing, purge and recovery cron requests
# CRON_SECRET=

# Dev
# Enables the dev login and preset backfill endpoints
NEXT_PUBLIC_ENABLE_DEV_ROUTES=false
# Set to true to expose this operator console; it stays hidden otherwise
NEXT_PUBLIC_ENABLE_ADMIN_ROUTES=false
# Lets the dev sign-in shortcut work on local next-start builds; never set it in a deployed environment
DEV_AUTH_ALLOW_LOCAL_PROD=false
# How much the server writes to its log; set it to debug when you are chasing something
LOG_LEVEL=info
# Set to 1 at build time to keep the browser test hooks in a production build; normal builds drop them
# NEXT_PUBLIC_E2E=
