{
  "name": "just-a-wrapper",
  "version": "1.0.0",
  "description": "Open-source, self-hosted AI workspace for teams on Claude Managed Agents. Chat, files, memory, connected apps, skills and scheduled tasks. Fork it and ship your own AI product.",
  "homepage": "https://wrapper.arnas.st",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/cptApe/just-a-wrapper.git"
  },
  "bugs": {
    "url": "https://github.com/cptApe/just-a-wrapper/issues"
  },
  "keywords": [
    "ai-workspace",
    "claude",
    "anthropic",
    "claude-managed-agents",
    "ai-agents",
    "chatgpt-alternative",
    "self-hosted",
    "nextjs",
    "react",
    "typescript",
    "postgresql",
    "drizzle-orm",
    "better-auth",
    "stripe",
    "composio",
    "mcp",
    "saas-boilerplate",
    "llm"
  ],
  "private": true,
  "engines": {
    "node": ">=22.9"
  },
  "packageManager": "pnpm@10.20.0",
  "scripts": {
    "dev": "next dev -p $(node scripts/resolve-dev-port.mjs)",
    "build": "next build",
    "start": "next start",
    "lint": "eslint . --max-warnings=0 --cache --cache-location node_modules/.cache/eslint/",
    "lint:fix": "eslint . --fix",
    "format": "biome check --write",
    "format:check": "biome ci",
    "typecheck": "next typegen && tsc --noEmit",
    "typecheck:fast": "next typegen && tsgo --noEmit",
    "validate:config": "node --import ./scripts/register-aliases.mjs --env-file-if-exists=.env --experimental-strip-types scripts/validate-config.ts",
    "db:generate": "drizzle-kit generate",
    "db:check": "drizzle-kit check",
    "db:migrate": "node --import ./scripts/register-aliases.mjs --env-file-if-exists=.env --experimental-strip-types scripts/db-migrate.ts",
    "seed:agents": "node --env-file-if-exists=.env --import ./scripts/register-aliases.mjs --experimental-strip-types scripts/seed-agents.ts",
    "setup": "node --import ./scripts/register-aliases.mjs --experimental-strip-types scripts/setup.ts",
    "seed:stripe": "node --import ./scripts/register-aliases.mjs --env-file-if-exists=.env --experimental-strip-types scripts/seed-stripe.ts",
    "skills:backfill": "node --import ./scripts/register-aliases.mjs --env-file-if-exists=.env --experimental-strip-types scripts/backfill-preset-skills.ts",
    "composio:remint": "node --import ./scripts/register-aliases.mjs --env-file-if-exists=.env --experimental-strip-types scripts/clear-tool-router-cache.ts",
    "stripe:secret": "node --import ./scripts/register-aliases.mjs --env-file-if-exists=.env --experimental-strip-types scripts/stripe-listen.ts --print-secret",
    "stripe:listen": "node --import ./scripts/register-aliases.mjs --env-file-if-exists=.env --experimental-strip-types scripts/stripe-listen.ts",
    "posthog:sync": "node --import ./scripts/register-aliases.mjs --env-file-if-exists=.env --experimental-strip-types scripts/posthog-sync.ts",
    "test:integration": "vitest run --config vitest.config.ts",
    "test:integration:docker": "docker compose -f docker-compose.test.yml up -d --wait && (pnpm test:integration; status=$?; docker compose -f docker-compose.test.yml down -v; exit $status)",
    "test:e2e": "playwright test --config playwright.config.ts",
    "deadcode": "knip",
    "layers": "node scripts/feature-edges.mjs",
    "drift": "drizzle-kit generate && git add --intent-to-add src/db/migrations && git diff --exit-code -- src/db/migrations",
    "verify": "pnpm format:check && pnpm lint && pnpm deadcode && pnpm typecheck && pnpm test:unit && pnpm drift && pnpm build",
    "env:example": "node --import ./scripts/register-aliases.mjs scripts/generate-env-example.mjs",
    "test:unit": "node --import ./scripts/register-aliases.mjs --test 'tests/**/*.test.mjs'"
  },
  "dependencies": {
    "@aiden0z/pptx-renderer": "1.4.0",
    "@anthropic-ai/sdk": "^0.116.0",
    "@browserbasehq/stagehand": "3.7.0",
    "@modelcontextprotocol/sdk": "^1.29.0",
    "@neondatabase/serverless": "^1.1.0",
    "@opentelemetry/api-logs": "^0.218.0",
    "@opentelemetry/exporter-logs-otlp-http": "^0.218.0",
    "@opentelemetry/resources": "^3.0.0",
    "@opentelemetry/sdk-logs": "^0.218.0",
    "@opentelemetry/semantic-conventions": "^1.41.1",
    "@posthog/nextjs-config": "^1.9.64",
    "@radix-ui/react-avatar": "1.1.11",
    "@radix-ui/react-dialog": "1.1.15",
    "@radix-ui/react-dropdown-menu": "2.1.16",
    "@radix-ui/react-focus-scope": "1.1.7",
    "@radix-ui/react-label": "2.1.8",
    "@radix-ui/react-popover": "1.1.15",
    "@radix-ui/react-progress": "1.1.8",
    "@radix-ui/react-select": "2.2.6",
    "@radix-ui/react-slider": "1.4.7",
    "@radix-ui/react-slot": "1.2.4",
    "@radix-ui/react-switch": "1.2.6",
    "@radix-ui/react-tabs": "1.1.13",
    "@radix-ui/react-tooltip": "1.2.8",
    "@shadcn/react": "0.2.0",
    "@streamdown/code": "^1.1.1",
    "@streamdown/math": "^1.0.2",
    "@t3-oss/env-nextjs": "^0.13.11",
    "@tanstack/react-query": "^5.101.2",
    "@vercel/blob": "^2.8.2",
    "ai": "^7.0.159",
    "better-auth": "^1.6.14",
    "class-variance-authority": "0.7.1",
    "clsx": "2.1.1",
    "cmdk": "^1.1.1",
    "color": "^5.0.3",
    "drizzle-orm": "^0.45.2",
    "fflate": "^0.8.3",
    "hls.js": "^1.6.16",
    "jose": "6.2.3",
    "katex": "^0.17.0",
    "mammoth": "^1.12.1",
    "next": "16.2.4",
    "next-themes": "^0.4.6",
    "nuqs": "^2.9.0",
    "pdfjs-dist": "6.1.200",
    "pino": "^10.3.1",
    "playwright-core": "^1.61.1",
    "posthog-js": "^1.386.1",
    "posthog-node": "^5.36.15",
    "react": "19.2.4",
    "react-dom": "19.2.4",
    "react-error-boundary": "6.1.1",
    "recharts": "3.8.0",
    "resend": "6.12.4",
    "sharp": "^0.35.5",
    "sonner": "2.0.7",
    "standardwebhooks": "^1.0.0",
    "streamdown": "^2.5.0",
    "stripe": "^22.2.0",
    "tailwind-merge": "3.5.0",
    "tw-animate-css": "1.4.0",
    "xlsx": "https://cdn.sheetjs.com/xlsx-0.20.3/xlsx-0.20.3.tgz",
    "zod": "^4.4.3"
  },
  "pnpm": {
    "packageExtensions": {
      "streamdown@2.5.0": {
        "dependencies": {
          "shiki": "3.23.0"
        }
      }
    },
    "overrides": {
      "kysely": "0.28.17"
    },
    "onlyBuiltDependencies": [
      "esbuild"
    ]
  },
  "devDependencies": {
    "@biomejs/biome": "^2.4.13",
    "@playwright/test": "^1.60.0",
    "@tailwindcss/postcss": "^4",
    "@types/node": "^20",
    "@types/react": "^19",
    "@types/react-dom": "^19",
    "@types/ws": "^8.18.1",
    "@typescript/native-preview": "7.0.0-dev.20260707.2",
    "drizzle-kit": "^0.31.10",
    "esbuild": "0.28.2",
    "eslint": "^9",
    "eslint-config-next": "16.2.4",
    "knip": "^6.25.0",
    "tailwindcss": "^4",
    "typescript": "^5",
    "typescript-eslint": "8.59.0",
    "vitest": "^4.1.8",
    "ws": "^8.21.0"
  },
  "license": "MIT"
}
