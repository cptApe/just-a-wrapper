{
  "$schema": "https://json.schemastore.org/claude-code-settings.json",
  "attribution": {
    "commit": ""
  },
  "permissions": {
    "allow": [
      "Bash(pnpm:*)",
      "Bash(git diff:*)",
      "Bash(git log:*)",
      "Bash(git status:*)",
      "Bash(git show:*)",
      "Bash(git add:*)",
      "Bash(git commit:*)"
    ],
    "ask": [
      "Bash(pnpm db:migrate:*)",
      "Bash(pnpm seed:agents:*)",
      "Bash(pnpm seed:stripe:*)",
      "Bash(pnpm run setup:*)",
      "Bash(pnpm posthog:sync:*)",
      "Bash(pnpm composio:remint:*)"
    ],
    "deny": ["Bash(git push --force:*)", "Bash(git push -f:*)", "Bash(git reset --hard:*)"]
  }
}
